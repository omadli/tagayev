# Tagayev Methods — environment variables
# Copy to .env and fill in real values.

# True for local dev, False in production.
# When False, the security block in settings.py activates (HTTPS redirect, HSTS,
# secure cookies) and refuses to start with an insecure SECRET_KEY or ALLOWED_HOSTS='*'.
DEBUG=True

# Generate a strong random key for production:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me

# Comma-separated. In production: tagayev.uz,www.tagayev.uz  (NOT '*')
ALLOWED_HOSTS=*

# Production HTTPS origins, comma-separated, e.g. https://tagayev.uz,https://www.tagayev.uz
CSRF_TRUSTED_ORIGINS=

# Admin panel URL prefix. Default "admin". In production set a hard-to-guess
# value so the login page is not on the obvious /admin/ path, e.g.
#   ADMIN_URL=boshqaruv-7x3k
# Leading/trailing slashes are optional (admin, /admin, admin/ all work).
#ADMIN_URL=admin

# Reverse proxies in front of the app: nginx=1. Set to 2 if Cloudflare (or any
# CDN/WAF) also proxies, so the lead-form rate-limit reads the real client IP
# from X-Forwarded-For instead of the proxy's. Default 1.
#TRUSTED_PROXY_COUNT=1

# --- Production security (optional; sane defaults when DEBUG=False) ---
# Redirect all HTTP to HTTPS (set False only if a proxy already does it).
#SECURE_SSL_REDIRECT=True
# HSTS max-age in seconds. On the FIRST HTTPS deploy use a small value (e.g.
# 3600) to be safe, then raise to a year (31536000) once TLS is confirmed stable.
#SECURE_HSTS_SECONDS=31536000
#SECURE_HSTS_INCLUDE_SUBDOMAINS=True
#SECURE_HSTS_PRELOAD=True

# Django log level (DEBUG/INFO/WARNING/ERROR). Default INFO.
#DJANGO_LOG_LEVEL=INFO

# --- Gunicorn (read by deploy/gunicorn.conf.py) ---
# Keep the worker pool small: SQLite prefers few concurrent writers.
#GUNICORN_WORKERS=3

# Telegram bot — applications (arizalar) are sent here.
# OPTIONAL fallback only: the bot token and the recipient admins are now
# managed from the admin panel (Sozlamalar → Sayt sozlamalari → Telegram, and
# Sozlamalar → Telegram qabul qiluvchilar). These env values are used only when
# the panel is left empty, so a fresh install keeps working out of the box.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
