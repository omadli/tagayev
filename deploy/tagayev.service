# Tagayev Methods — gunicorn (Django/WSGI) service, unit name: tagayev.service
#
# Install:
#   sudo cp deploy/tagayev.service /etc/systemd/system/tagayev.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now tagayev
#   sudo systemctl status tagayev
#
# Adjust User/Group, WorkingDirectory and paths to match your server.

[Unit]
Description=Tagayev Methods gunicorn daemon
After=network.target

[Service]
# Runs as the ordinary 'ubuntu' login user (no dedicated service user). Group is
# www-data so the nginx worker can read the unix socket in /run/tagayev.
User=ubuntu
Group=www-data

WorkingDirectory=/home/ubuntu/tagayev
EnvironmentFile=/home/ubuntu/tagayev/.env

# systemd creates /run/tagayev owned by User:Group on start, where gunicorn
# places its unix socket; it is removed automatically on stop.
RuntimeDirectory=tagayev
RuntimeDirectoryMode=0750

ExecStart=/home/ubuntu/tagayev/venv/bin/gunicorn \
    --config /home/ubuntu/tagayev/deploy/gunicorn.conf.py \
    config.wsgi:application
ExecReload=/bin/kill -s HUP $MAINPID

Restart=always
RestartSec=3
KillMode=mixed
TimeoutStopSec=30

# --- Hardening (sandbox the service) ---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
# The app needs to write uploads (media/), the SQLite DB and WAL files. This
# ReadWritePaths overrides ProtectHome=read-only for the project subtree only —
# the rest of /home/ubuntu stays read-only. (gunicorn's control socket is
# disabled in gunicorn.conf.py, so nothing tries to write to ~/.gunicorn.)
ReadWritePaths=/home/ubuntu/tagayev

[Install]
WantedBy=multi-user.target
